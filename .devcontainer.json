{
  "name": "Jutge.org Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "build-essential,clang,gdb,imagemagick"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15",
      "installTools": false,
      "installJupyterlab": false
    }
  },

  "postCreateCommand": {
    "python-packages": "pip install --no-cache-dir numpy mypy pycodestyle yogi turtle-pil"
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "jutge-org.jutge-vscode"
      ]
    }
  }
}
