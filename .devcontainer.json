{
  "name": "Jutge.org Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",

  "features": {
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "build-essential,gcc,g++,gdb,make,clang,openjdk-17-jdk-headless,ghc,clojure,curl,unzip,ca-certificates"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15",
      "installTools": false,
      "installJupyterlab": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "postCreateCommand": {
    "python-packages": "pip install --no-cache-dir yogi numpy mypy pycodestyle turtle-pil",
    "codon": "mkdir -p \"$HOME/.codon\" && curl -fsSL \"https://github.com/exaloop/codon/releases/latest/download/codon-linux-$(uname -m).tar.gz\" | tar -xzf - -C \"$HOME/.codon\" --strip-components=1",
    "bun": "curl -fsSL https://bun.sh/install | bash"
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.codon/bin:/home/vscode/.bun/bin"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.java",
        "haskell.haskell",
        "betterthantomorrow.calva",
        "oven.bun-vscode",
        "jutge-org.jutge-vscode"
      ]
    }
  }
}
